const state = { design: 'A', layer: 'red', param: 'width', p: { ...CUFF.defaults } };
const css = v => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
const V = { sub: (a, b) => [a[0]-b[0], a[1]-b[1], a[2]-b[2]], add: (a, b) => [a[0]+b[0], a[1]+b[1], a[2]+b[2]], mul: (a, k) => [a[0]*k, a[1]*k, a[2]*k], dot: (a, b) => a[0]*b[0]+a[1]*b[1]+a[2]*b[2] };
const { p0, n, axis, u, centre, span } = CUFF;
const yel = CUFF.curves.find(c => c.role === 'yellow').pts;
const axLen = Math.abs(V.dot(V.sub(yel[yel.length-1], yel[0]), axis)) || 1;

/* MODEL: a point of a guide curve of the kept half, shaped by the parameters; its mirror follows. */
function shape(P, curve, i) {
  const s = state.p; let q = P;
  if (curve.role === 'arc' || curve.role === 'side') {
    const a = curve.pts[0], b = curve.pts[curve.pts.length-1], k = i / (curve.pts.length-1);
    const chord = V.add(V.mul(a, 1-k), V.mul(b, k));
    q = V.add(q, V.mul(V.sub(chord, q), s.arcs));
  }
  const d = V.dot(V.sub(q, p0), n), t = Math.min(1, Math.max(0, Math.abs(V.dot(V.sub(q, yel[0]), axis)) / axLen));
  q = V.add(q, V.mul(u, s.yellow * Math.sin(Math.PI * t) * Math.exp(-(d*d)/(TOKENS.falloff*TOKENS.falloff))));
  q = V.add(q, V.mul(n, (s.width-1) * V.dot(V.sub(q, p0), n)));
  q = V.add(q, V.mul(u, (s.bulge-1) * V.dot(V.sub(q, p0), u)));
  return q;
}
const mirror = q => V.sub(q, V.mul(n, 2 * V.dot(V.sub(q, p0), n)));
function curves3() {
  const out = [];
  for (const c of CUFF.curves) {
    const pts = c.pts.map((P, i) => shape(P, c, i));
    out.push({ role: c.role, pts }); out.push({ role: c.role, pts: pts.map(mirror), mirrored: true });
  }
  return out;
}
const layerOf = role => role === 'yellow' ? 'yellow' : (role === 'arc' ? 'arcs' : 'red');

/* VIEWS: the main one from three quarters above (the mirror runs left to right), the small one from the top. */
function project(q, kind, w, h) {
  const r = V.sub(q, centre), k = TOKENS.view3q * Math.PI / 180, sc = Math.min(w, h * 1.5) / (span * 1.08);
  if (kind === 'top') return [w/2 + V.dot(r, n) * sc * 0.9, h/2 - V.dot(r, u) * sc * 0.9 + h*0.1];
  return [w/2 + V.dot(r, n) * sc, h/2 + (V.dot(r, axis) * Math.cos(k) - V.dot(r, u) * Math.sin(k)) * sc];
}
function fit(cv) { const r = cv.getBoundingClientRect(), d = window.devicePixelRatio || 1; cv.width = Math.round(r.width * d); cv.height = Math.round(r.height * d); const g = cv.getContext('2d'); g.setTransform(d, 0, 0, d, 0, 0); return [g, r.width, r.height]; }
let HANDLES = [], LAST = [];
function draw() {
  const cs = curves3(); LAST = [];
  for (const [id, kind] of [['cv', 'main'], ['cvTop', 'top']]) {
    const [g, w, h] = fit(document.getElementById(id));
    g.clearRect(0, 0, w, h); g.lineJoin = g.lineCap = 'round';
    const order = ['arc', 'side', 'rim', 'yellow'];
    for (const role of order) for (const c of cs) {
      if (c.role !== role) continue;
      const lay = layerOf(c.role), sel = lay === state.layer || (state.layer === 'thick' && lay === 'red');
      const pts = c.pts.map(q => project(q, kind, w, h));
      if (kind === 'main') LAST.push({ lay, pts });
      g.globalAlpha = sel ? 1 : TOKENS.dim;
      g.strokeStyle = css(lay === 'yellow' ? '--yl' : lay === 'arcs' ? '--tq' : '--red');
      g.lineWidth = (sel ? TOKENS.lineSel : TOKENS.line) * (kind === 'top' ? 0.6 : 1);
      g.beginPath(); pts.forEach((p, i) => i ? g.lineTo(p[0], p[1]) : g.moveTo(p[0], p[1])); g.stroke();
      if (lay === 'red' && state.p.thickness > 0) {            /* the thickness: the same contour, set back into the plate */
        const inner = c.pts.map(q => project(V.sub(q, V.mul(u, -state.p.thickness)), kind, w, h));
        g.globalAlpha = (state.layer === 'thick' ? 1 : TOKENS.dim) * 0.9; g.lineWidth = (state.layer === 'thick' ? 2.2 : 1) * (kind === 'top' ? 0.6 : 1);
        g.strokeStyle = state.layer === 'thick' ? '#ffffff' : css('--red');
        g.beginPath(); inner.forEach((p, i) => i ? g.lineTo(p[0], p[1]) : g.moveTo(p[0], p[1])); g.stroke();
      }
    }
    g.globalAlpha = 1;
    if (kind === 'main' && state.design === 'B') drawHandles(g, cs, w, h);
  }
  readout();
}

/* SKIN B: one handle per thing, on the drawing. */
function drawHandles(g, cs, w, h) {
  const kept = r => cs.filter(c => c.role === r && !c.mirrored);
  const mid = c => c.pts[Math.floor(c.pts.length / 2)];
  const arcs = kept('arc'), rims = kept('rim');
  const spots = [
    { param: 'width',     layer: 'red',    at: mid(kept('side')[0]),                 dir: [1, 0],  gain: (PARAMS.width.max - PARAMS.width.min) / (w * 0.5) },
    { param: 'bulge',     layer: 'red',    at: mid(rims[0]),                         dir: [0, -1], gain: (PARAMS.bulge.max - PARAMS.bulge.min) / (h * 0.5) },
    { param: 'yellow',    layer: 'yellow', at: mid(kept('yellow')[0]),               dir: [0, -1], gain: 60 / (h * 0.5) },
    { param: 'arcs',      layer: 'arcs',   at: mid(arcs[Math.floor(arcs.length/2)]), dir: [1, 0],  gain: 1.3 / (w * 0.4) },
    { param: 'thickness', layer: 'thick',  at: mid(rims[rims.length-1]),             dir: [0, 1],  gain: 40 / (h * 0.35) },
  ];
  HANDLES = spots.map(s => ({ ...s, xy: project(s.at, 'main', w, h) }));
  for (const hd of HANDLES) {
    const on = hd.param === state.param;
    g.beginPath(); g.arc(hd.xy[0], hd.xy[1], TOKENS.handle, 0, 7); g.fillStyle = '#ffffff'; g.globalAlpha = on ? 1 : 0.85; g.fill();
    g.lineWidth = on ? 4 : 2.5; g.strokeStyle = css(LAYERS.find(l => l.id === hd.layer).colour) || '#fff'; if (hd.layer === 'thick') g.strokeStyle = '#15171c'; g.stroke(); g.globalAlpha = 1;
  }
  const cur = HANDLES.find(hd => hd.param === state.param), pill = document.getElementById('pill');
  if (cur) { pill.style.left = cur.xy[0] + 'px'; pill.style.top = cur.xy[1] + 'px'; pill.textContent = PARAMS[cur.param].label + ' ' + fmt(cur.param); pill.style.opacity = 1; }
}
const fmt = k => state.p[k].toFixed(PARAMS[k].digits) + (PARAMS[k].unit ? ' ' + PARAMS[k].unit : '');
const clamp = (k, v) => Math.min(PARAMS[k].max, Math.max(PARAMS[k].min, Math.round(v / PARAMS[k].step) * PARAMS[k].step));
function set(k, v) { state.p[k] = clamp(k, v); sync(); }
function select(layer, param) { state.layer = layer; state.param = param || LAYERS.find(l => l.id === layer).params[0]; sync(); }
function readout() {
  const s = state.p;
  document.getElementById('read').textContent = `ZRB3D · ${CUFF.project} · ${CUFF.component} · thickness=${s.thickness.toFixed(1)} width=${s.width.toFixed(2)} bulge=${s.bulge.toFixed(2)} yellow=${s.yellow.toFixed(1)} arcs=${s.arcs.toFixed(2)} turn=${s.turn}`;
}

/* SKIN A: a layer, its sliders. */
function buildA() {
  const chips = document.getElementById('chips'); chips.innerHTML = '';
  for (const l of LAYERS) {
    const b = document.createElement('button'); b.className = 'chip'; b.setAttribute('aria-pressed', l.id === state.layer);
    b.innerHTML = `<span class="dot" style="background:var(${l.colour});${l.id === 'thick' ? 'border:1px solid var(--line)' : ''}"></span>${l.name}`;
    b.onclick = () => select(l.id); chips.appendChild(b);
  }
  const box = document.getElementById('sliders'); box.innerHTML = '';
  for (const k of LAYERS.find(l => l.id === state.layer).params) {
    const P = PARAMS[k], row = document.createElement('div'); row.className = 'row';
    row.innerHTML = `<label><span>${P.label}</span><output>${fmt(k)}</output></label><input type="range" min="${P.min}" max="${P.max}" step="${P.step}" value="${state.p[k]}" aria-label="${P.label}">`;
    row.querySelector('input').oninput = e => { state.p[k] = +e.target.value; state.param = k; row.querySelector('output').textContent = fmt(k); draw(); };
    box.appendChild(row);
  }
}

/* SKIN C: pick a thing, turn the wheel. */
function buildC() {
  const seg = document.getElementById('seg'); seg.innerHTML = '';
  for (const l of LAYERS) for (const k of l.params) {
    const b = document.createElement('button'); b.className = 'chip'; b.setAttribute('aria-pressed', k === state.param);
    b.innerHTML = `<span class="dot" style="background:var(${l.colour});${l.id === 'thick' ? 'border:1px solid var(--line)' : ''}"></span>${PARAMS[k].label}`;
    b.onclick = () => select(l.id, k); seg.appendChild(b);
  }
  const P = PARAMS[state.param], f = (state.p[state.param] - P.min) / (P.max - P.min);
  document.getElementById('knob').setAttribute('transform', `rotate(${-150 + 300 * f})`);
  document.getElementById('big').textContent = fmt(state.param);
  const pre = document.getElementById('presets'); pre.innerHTML = '';
  for (const v of P.presets) { const b = document.createElement('button'); b.className = 'chip'; b.textContent = v.toFixed(P.digits) + (P.unit ? ' ' + P.unit : ''); b.onclick = () => set(state.param, v); pre.appendChild(b); }
  const tk = document.getElementById('ticks'); tk.innerHTML = '';
  for (let i = 0; i <= 10; i++) { const a = (-150 + 30 * i - 90) * Math.PI / 180; tk.innerHTML += `<line x1="${54*Math.cos(a)}" y1="${54*Math.sin(a)}" x2="${60*Math.cos(a)}" y2="${60*Math.sin(a)}" stroke="var(--mute)" stroke-width="1.5"/>`; }
}
function sync() {
  document.querySelectorAll('.tab').forEach(t => t.setAttribute('aria-selected', t.dataset.design === state.design));
  document.getElementById('panelA').hidden = state.design !== 'A';
  document.getElementById('panelC').hidden = state.design !== 'C';
  document.getElementById('stage').classList.toggle('with-panel', state.design === 'A');
  if (state.design !== 'B') document.getElementById('pill').style.opacity = 0;
  document.getElementById('note').textContent = {
    A: 'A : on choisit une couleur, on règle un ou deux curseurs. Le plus proche des paramètres d’un HDA dans Houdini ; tout tient dans un panneau.',
    B: 'B : rien d’autre que le dessin. Une poignée par réglage, posée sur la courbe concernée ; on la tire, la valeur s’affiche à côté, les deux moitiés suivent.',
    C: 'C : on touche une courbe (ou son nom), puis on tourne la molette, comme on agrandirait une roue. Les boutons plus et moins avancent d’un cran, trois valeurs toutes faites à droite.' }[state.design];
  if (state.design === 'A') buildA(); if (state.design === 'C') buildC();
  draw();
}

/* pointer: handles (B), picking a curve (B and C), the wheel (C) */
const view = document.getElementById('view'); let drag = null;
const local = e => { const r = view.getBoundingClientRect(); return [e.clientX - r.left, e.clientY - r.top]; };
view.addEventListener('pointerdown', e => {
  const m = local(e);
  if (state.design === 'B') { const hd = HANDLES.find(hd => Math.hypot(hd.xy[0]-m[0], hd.xy[1]-m[1]) <= TOKENS.handle + 8); if (hd) { drag = { hd, m, v0: state.p[hd.param] }; select(hd.layer, hd.param); view.setPointerCapture(e.pointerId); return; } }
  if (state.design !== 'A') { let best = null; for (const c of LAST) for (const p of c.pts) { const d = Math.hypot(p[0]-m[0], p[1]-m[1]); if (d <= TOKENS.hit && (!best || d < best.d)) best = { d, lay: c.lay }; } if (best) select(best.lay); }
});
view.addEventListener('pointermove', e => { if (!drag) return; const m = local(e), d = (m[0]-drag.m[0]) * drag.hd.dir[0] + (m[1]-drag.m[1]) * drag.hd.dir[1]; set(drag.hd.param, drag.v0 + d * drag.hd.gain); });
view.addEventListener('pointerup', () => { drag = null; });
const dial = document.getElementById('dial'); let turn = null;
const ang = e => { const r = dial.getBoundingClientRect(); return Math.atan2(e.clientY - (r.top + r.height/2), e.clientX - (r.left + r.width/2)); };
dial.addEventListener('pointerdown', e => { turn = { a: ang(e), v0: state.p[state.param] }; dial.setPointerCapture(e.pointerId); });
dial.addEventListener('pointermove', e => { if (!turn) return; let d = ang(e) - turn.a; if (d > Math.PI) d -= 2*Math.PI; if (d < -Math.PI) d += 2*Math.PI; const P = PARAMS[state.param]; turn.v0 = clamp(state.param, turn.v0 + d / (2*Math.PI*300/360) * (P.max - P.min) * TOKENS.dialTurn); turn.a = ang(e); set(state.param, turn.v0); });
dial.addEventListener('pointerup', () => { turn = null; });
document.getElementById('minus').onclick = () => set(state.param, state.p[state.param] - PARAMS[state.param].step * 5);
document.getElementById('plus').onclick = () => set(state.param, state.p[state.param] + PARAMS[state.param].step * 5);
document.querySelectorAll('.tab').forEach(t => t.onclick = () => { state.design = t.dataset.design; sync(); });
document.getElementById('reset').onclick = () => { state.p = { ...CUFF.defaults }; sync(); };
document.getElementById('copy').onclick = async () => {
  const t = document.getElementById('read').textContent, b = document.getElementById('copy');
  try { await navigator.clipboard.writeText(t); } catch (err) { const a = document.createElement('textarea'); a.value = t; document.body.appendChild(a); a.select(); document.execCommand('copy'); a.remove(); }
  b.textContent = 'Copié'; setTimeout(() => { b.textContent = 'Copier les paramètres'; }, 1200);
};
window.addEventListener('resize', draw);
sync();
</script>
</body>
</html>
