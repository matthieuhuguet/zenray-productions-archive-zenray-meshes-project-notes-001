  --ui:15px; --ui-s:13px; --title:26px;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){ --paper:#121317; --ink:#eceae6; --mute:#9197a1; --line:#2a2d34; --card:#1a1c21; } }
@media (prefers-reduced-motion: reduce){ :root{ --t:0s } }
*{box-sizing:border-box}
html,body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font);font-size:var(--ui);font-synthesis:none}
main{max-width:1180px;margin:0 auto;padding:28px 16px 40px}
h1{font-size:var(--title);font-weight:500;margin:0 0 6px}
p.lead{margin:0 0 20px;color:var(--mute);max-width:70ch;line-height:1.45}
.tabs{display:flex;gap:8px;margin-bottom:var(--gap);flex-wrap:wrap}
.tab{border:1px solid var(--line);background:var(--card);color:var(--ink);font:inherit;padding:10px 16px;border-radius:999px;cursor:pointer;min-height:44px;transition:background var(--t),color var(--t),border-color var(--t)}
.tab[aria-selected="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.stage{display:grid;grid-template-columns:1fr;gap:var(--gap)}
.stage.with-panel{grid-template-columns:minmax(0,1fr) 300px}
@media (max-width:820px){ .stage.with-panel{grid-template-columns:1fr} }
.view{position:relative;background:var(--blue);border-radius:var(--radius);overflow:hidden;aspect-ratio:16/10;max-height:62vh;width:100%;touch-action:none}
.view canvas{position:absolute;inset:0;width:100%;height:100%}
.inset{position:absolute;right:12px;top:12px;width:22%;aspect-ratio:1.5;border:1px solid rgba(255,255,255,.28);border-radius:10px;background:rgba(13,58,128,.72);overflow:hidden}
.inset canvas{position:absolute;inset:0;width:100%;height:100%}
.pill{position:absolute;padding:4px 10px;border-radius:999px;background:rgba(255,255,255,.94);color:#15171c;font-size:var(--ui-s);pointer-events:none;transform:translate(-50%,-140%);white-space:nowrap;transition:opacity var(--t)}
.panel{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:16px;display:flex;flex-direction:column;gap:14px}
.chips{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.chip{display:flex;align-items:center;gap:8px;border:1px solid var(--line);background:transparent;color:var(--ink);font:inherit;padding:10px 12px;border-radius:12px;cursor:pointer;min-height:44px;text-align:left;transition:border-color var(--t),background var(--t)}
.chip[aria-pressed="true"]{border-color:var(--ink);background:color-mix(in srgb,var(--ink) 6%,transparent)}
.dot{width:12px;height:12px;border-radius:50%;flex:none}
.row{display:flex;flex-direction:column;gap:6px}
.row label{display:flex;justify-content:space-between;color:var(--mute);font-size:var(--ui-s)}
.row output{color:var(--ink)}
input[type=range]{width:100%;height:44px;accent-color:var(--ink);margin:0}
.bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:var(--gap)}
.read{flex:1;min-width:240px;font-size:var(--ui-s);color:var(--mute);background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 14px;overflow-wrap:anywhere}
button.act{border:1px solid var(--ink);background:var(--ink);color:var(--paper);font:inherit;padding:10px 16px;border-radius:12px;cursor:pointer;min-height:44px;transition:opacity var(--t)}
button.ghost{background:transparent;color:var(--ink);border-color:var(--line)}
button.act:active{opacity:.7}
.dialwrap{display:flex;gap:18px;align-items:center;flex-wrap:wrap;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:14px 16px}
.seg{display:flex;gap:6px;flex-wrap:wrap}
.dial{width:132px;height:132px;flex:none;touch-action:none;cursor:grab}
.steps{display:flex;gap:6px;align-items:center}
.steps button{width:44px;height:44px;border-radius:12px;border:1px solid var(--line);background:transparent;color:var(--ink);font:inherit;font-size:20px;cursor:pointer}
.big{font-size:28px;font-weight:500;min-width:5.5ch;text-align:center}
.note{color:var(--mute);font-size:var(--ui-s);margin:10px 0 0;max-width:80ch;line-height:1.45}
[hidden]{display:none!important}
